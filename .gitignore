# Secrets and signing material — never commit these
tg.properties
*.jks
*.keystore

# Build outputs
*.apk
*.dex
*.class
build/
out/

# Server (tikdl/) runtime secrets and deps — also covered by tikdl/.gitignore
.env
.env.local
cookies.txt
node_modules/
*.log

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
